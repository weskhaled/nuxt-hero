{
  "name": "nuxt-hero",
  "version": "0.8.0",
  "description": "A full-featured hero slider for Nuxt AND plain Vue 3 — parallax, video backgrounds, overlay patterns, customizable animations. Zero-Tailwind plain-CSS styling, touch-friendly, RTL + a11y ready.",
  "license": "MIT",
  "author": "weskhaled",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weskhaled/nuxt-hero.git"
  },
  "homepage": "https://github.com/weskhaled/nuxt-hero#readme",
  "bugs": {
    "url": "https://github.com/weskhaled/nuxt-hero/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "vue-plugin",
    "hero",
    "slider",
    "carousel",
    "parallax",
    "video",
    "swiper"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./vue": {
      "types": "./dist/vue/types/vue/index.d.ts",
      "import": "./dist/vue/index.mjs"
    },
    "./vue/parallax": {
      "types": "./dist/vue/types/vue/parallax.d.ts",
      "import": "./dist/vue/parallax.mjs"
    },
    "./hero.css": "./dist/runtime/assets/hero.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:fresh": "rm -rf node_modules/.vite playground/.nuxt && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "example:vue": "pnpm --filter nuxt-hero-example-vue dev",
    "example:vue:build": "pnpm --filter nuxt-hero-example-vue build",
    "build": "nuxt-module-build build && vite build -c vite.vue.config.ts",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prepack": "pnpm build",
    "typecheck": "nuxi typecheck playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint . && pnpm build && pnpm test",
    "lint:fix": "oxlint --fix .",
    "lint:all": "oxlint . && pnpm build && pnpm test && pnpm typecheck && pnpm test:types",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "pathe": "^2.0.3"
  },
  "peerDependencies": {
    "@nuxt/image": ">=2.0.0",
    "@vueuse/core": "^14.2.1 || ^15.0.0",
    "gsap": ">=3.12.0",
    "hls.js": "^1.5.0",
    "swiper": "^11.0.0 || ^12.0.0 || ^14.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/image": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.2.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "animate.css": "^4.1.1",
    "gsap": "^3.15.0",
    "happy-dom": "^21.0.4",
    "hls.js": "^1.7.3",
    "nuxt": "^4.6.2",
    "oxlint": "^1.89.0",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
