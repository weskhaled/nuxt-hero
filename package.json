{
  "name": "nuxt-hero",
  "version": "0.6.0",
  "description": "A full-featured hero slider Nuxt module with parallax, video backgrounds, overlay patterns, and customizable animations.",
  "license": "MIT",
  "author": "weskhaled",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weskhaled/nuxt-hero.git"
  },
  "homepage": "https://github.com/weskhaled/nuxt-hero#readme",
  "bugs": {
    "url": "https://github.com/weskhaled/nuxt-hero/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "hero",
    "slider",
    "parallax",
    "video",
    "swiper",
    "gsap",
    "tailwindcss"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:fresh": "rm -rf node_modules/.vite playground/.nuxt && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prepack": "nuxt-module-build build",
    "typecheck": "nuxi typecheck playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint . && pnpm build && pnpm test",
    "lint:fix": "oxlint --fix .",
    "lint:all": "oxlint . && pnpm build && pnpm test && pnpm typecheck && pnpm test:types",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "pathe": "^2.0.3"
  },
  "peerDependencies": {
    "@nuxt/image": ">=2.0.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": ">=14.2.1",
    "animate.css": "^4.1.1",
    "gsap": ">=3.12.0",
    "hls.js": "^1.5.0",
    "swiper": "^11.0.0 || ^12.0.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/image": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "animate.css": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.113",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/image": "^2.0.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "animate.css": "^4.1.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "nuxt": "^4.4.8",
    "oxlint": "^1.70.0",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}